1) DATABASE
CREATE DATABASE food_delivery; USE food_delivery;

2) CUSTOMER TABLE
CREATE TABLE CUSTOMER ( customer_id INT PRIMARY KEY, customer_name VARCHAR(50), phone VARCHAR(15), address VARCHAR(100), city VARCHAR(50) );

3) RESTAURANT TABLE
CREATE TABLE RESTAURANT ( rest_id INT PRIMARY KEY, rest_name VARCHAR(50), location VARCHAR(100), phone VARCHAR(15) );

4) FOOD TABLE
CREATE TABLE FOOD ( food_id INT PRIMARY KEY, food_name VARCHAR(50), price DECIMAL(10,2), category VARCHAR(30), rest_id INT, FOREIGN KEY (rest_id) REFERENCES RESTAURANT(rest_id) );

5) ORDERS TABLE
CREATE TABLE ORDERS ( order_id INT PRIMARY KEY, customer_id INT, order_date DATE, total_amount DECIMAL(10,2), status VARCHAR(20), FOREIGN KEY (customer_id) REFERENCES CUSTOMER(customer_id) );

6) ORDER_ITEMS TABLE
CREATE TABLE ORDER_ITEMS ( order_item_id INT PRIMARY KEY, order_id INT, food_id INT, quantity INT, subtotal DECIMAL(10,2), FOREIGN KEY (order_id) REFERENCES ORDERS(order_id), FOREIGN KEY (food_id) REFERENCES FOOD(food_id) );

7) DELIVERY TABLE
CREATE TABLE DELIVERY ( delivery_id INT PRIMARY KEY, order_id INT, delivery_person VARCHAR(50), delivery_status VARCHAR(20), delivery_time VARCHAR(30), FOREIGN KEY (order_id) REFERENCES ORDERS(order_id) );

8) PAYMENT TABLE
CREATE TABLE PAYMENT ( payment_id INT PRIMARY KEY, order_id INT, payment_method VARCHAR(20), payment_status VARCHAR(20), amount DECIMAL(10,2), FOREIGN KEY (order_id) REFERENCES ORDERS(order_id) );

